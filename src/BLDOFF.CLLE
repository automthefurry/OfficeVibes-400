  /* a screen file that someone has open cannot be replaced */
  CHGVAR     VAR(&INUSE) VALUE('0')
  ALCOBJ     OBJ((OFFICE/OFFMNU *FILE *EXCL)) WAIT(0)
  MONMSG     MSGID(CPF1002) EXEC(CHGVAR VAR(&INUSE) VALUE('1'))
  MONMSG     MSGID(CPF0000)
  IF         COND(&INUSE *EQ '1') THEN(CHGVAR VAR(&FAIL) +
               VALUE(&FAIL *BCAT 'OFFMNU(IN-USE)'))
  DLCOBJ     OBJ((OFFICE/OFFMNU *FILE *EXCL))
  MONMSG     MSGID(CPF0000)
  IF         COND(&INUSE *EQ '1') THEN(GOTO CMDLBL(SOFFMNU))
  CRTDSPF    FILE(OFFICE/OFFMNU) SRCFILE(OFFICE/QDDSSRC) SRCMBR(OFFMNU)
  MONMSG     MSGID(CPF0000 RNS0000 MCH0000) EXEC(CHGVAR VAR(&FAIL) +
               VALUE(&FAIL *BCAT 'OFFMNU screens'))
