/* OFFMNUC - program behind the GO OFFICE menu */
PGM        PARM(&MNU &MNULIB &RTNCDE)
  DCL        VAR(&MNU)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&MNULIB) TYPE(*CHAR) LEN(10)
  DCL        VAR(&RTNCDE) TYPE(*CHAR) LEN(2)
  ADDLIBLE   LIB(OFFICE)
  MONMSG     MSGID(CPF0000)
  CALL       PGM(OFFICE/OFFMENU)
  MONMSG     MSGID(CPF0000)
  CHGVAR     VAR(&RTNCDE) VALUE(X'FFFF')
ENDPGM
